# Public source defaults; not a complete runtime environment.
IMAGE_VERSION=3.0.0
IMAGE_NAME=ghcr.io/open-telemetry/demo
DEMO_VERSION=latest
OTEL_JAVA_AGENT_VERSION=2.31.1
OPENTELEMETRY_CPP_VERSION=1.28.0
OPAMP_GO_REF=40c117bcec97130c236fc4b9aabc3a1a5e514c50
COLLECTOR_CONTRIB_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.159.0
COLLECTOR_EBPF_PROFILER_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-ebpf-profiler:0.159.0
FIREPIT_IMAGE=ghcr.io/florianl/firepit:v0.1.0
FLAGD_IMAGE=ghcr.io/open-feature/flagd:v0.16.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
JAEGERTRACING_IMAGE=quay.io/jaegertracing/jaeger:2.19.0
OPENSEARCH_DOCKERFILE=./src/opensearch/Dockerfile
POSTGRES_IMAGE=postgres:18.4
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.13.1
VALKEY_IMAGE=ghcr.io/valkey-io/valkey:9.0.4-alpine3.23
ENV_PLATFORM=local
IPV6_ENABLED=false
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_COLLECTOR_CONFIG=./src/otel-collector/otelcol-config.yml
OTEL_COLLECTOR_CONFIG_FULL=./src/otel-collector/otelcol-config-full.yml
OTEL_COLLECTOR_CONFIG_OBSERVABILITY=./src/otel-collector/otelcol-config-observability.yml
OTEL_COLLECTOR_CONFIG_EXTRAS=./src/otel-collector/otelcol-config-extras.yml
OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC}
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:8080/otlp-http/v1/traces
OTEL_SERVICE_NAMESPACE=opentelemetry-demo
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION}
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION=explicit_bucket_histogram
ACCOUNTING_DOCKERFILE=./src/accounting/Dockerfile
AD_PORT=9555
AD_ADDR=ad:${AD_PORT}
AD_PROMETHEUS_PORT=9465
AD_DOCKERFILE=./src/ad/Dockerfile
CART_PORT=7070
CART_ADDR=cart:${CART_PORT}
CART_DOCKERFILE=./src/cart/src/Dockerfile
CHECKOUT_PORT=5050
CHECKOUT_ADDR=checkout:${CHECKOUT_PORT}
CHECKOUT_DOCKERFILE=./src/checkout/Dockerfile
CURRENCY_PORT=7001
CURRENCY_ADDR=currency:${CURRENCY_PORT}
CURRENCY_DOCKERFILE=./src/currency/Dockerfile
EMAIL_PORT=6060
EMAIL_ADDR=http://email:${EMAIL_PORT}
EMAIL_DOCKERFILE=./src/email/Dockerfile
FRAUD_DOCKERFILE=./src/fraud-detection/Dockerfile
ENVOY_ADDR=0.0.0.0
ENVOY_PORT=8080
ENVOY_ADMIN_PORT=10000
FRONTEND_HOST=frontend
FRONTEND_PROXY_ADDR=frontend-proxy:${ENVOY_PORT}
FRONTEND_PROXY_DOCKERFILE=./src/frontend-proxy/Dockerfile
FRONTEND_PORT=8080
FRONTEND_ADDR=${FRONTEND_HOST}:${FRONTEND_PORT}
FRONTEND_DOCKERFILE=./src/frontend/Dockerfile
IMAGE_PROVIDER_HOST=image-provider
IMAGE_PROVIDER_PORT=8081
IMAGE_PROVIDER_DOCKERFILE=./src/image-provider/Dockerfile
LOCUST_WEB_PORT=8089
LOCUST_USERS=5
LOCUST_HOST=http://${FRONTEND_PROXY_ADDR}
LOCUST_WEB_HOST=load-generator
LOCUST_AUTOSTART=true
LOCUST_HTTP_USER_WEIGHT=9
LOCUST_BROWSER_USER_WEIGHT=1
LOCUST_HEADLESS=false
LOAD_GENERATOR_DOCKERFILE=./src/load-generator/Dockerfile
PAYMENT_PORT=50051
PAYMENT_ADDR=payment:${PAYMENT_PORT}
PAYMENT_DOCKERFILE=./src/payment/Dockerfile
PRODUCT_CATALOG_PORT=3550
PRODUCT_CATALOG_ADDR=product-catalog:${PRODUCT_CATALOG_PORT}
PRODUCT_CATALOG_DOCKERFILE=./src/product-catalog/Dockerfile
QUOTE_PORT=8090
QUOTE_ADDR=http://quote:${QUOTE_PORT}
QUOTE_DOCKERFILE=./src/quote/Dockerfile
RECOMMENDATION_PORT=9001
RECOMMENDATION_ADDR=recommendation:${RECOMMENDATION_PORT}
RECOMMENDATION_DOCKERFILE=./src/recommendation/Dockerfile
SHIPPING_PORT=50050
SHIPPING_ADDR=http://shipping:${SHIPPING_PORT}
SHIPPING_DOCKERFILE=./src/shipping/Dockerfile
FLAGD_HOST=flagd
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016
FLAGD_UI_HOST=flagd-ui
FLAGD_UI_PORT=4000
FLAGD_UI_DOCKERFILE=./src/flagd-ui/Dockerfile
KAFKA_PORT=9092
KAFKA_HOST=kafka
KAFKA_ADDR=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_TOPIC=orders
KAFKA_DOCKERFILE=./src/kafka/Dockerfile
VALKEY_PORT=6379
VALKEY_ADDR=valkey-cart:${VALKEY_PORT}
POSTGRES_HOST=astronomy-db
POSTGRES_PORT=5432
POSTGRES_DOCKERFILE=./src/postgresql/Dockerfile
GRAFANA_PORT=3000
GRAFANA_HOST=grafana
JAEGER_HOST=jaeger
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
PROMETHEUS_PORT=9090
PROMETHEUS_HOST=prometheus
PROMETHEUS_ADDR=${PROMETHEUS_HOST}:${PROMETHEUS_PORT}
GRAPH_RECURSION_LIMIT=25
MCP_ENDPOINT=mcp
MCP_PORT=8011
MCP_ENABLED=False
AGENT_ENDPOINT=agent
AGENT_PORT=8010
CHATBOT_HOST=chatbot
CHATBOT_PORT=7860
CHATBOT_ROOT_PATH=/chatbot
LLM_BASE_URL=https://local-llm.com
LLM_MODEL=azure/gpt-5.5
USE_VCR=True
VCR_MATCH_THRESHOLD=0.85
LLM_TLS_VERIFY=True
AGENT_DOCKERFILE=src/agent/Dockerfile
MCP_DOCKERFILE=src/mcp/Dockerfile
CHATBOT_DOCKERFILE=src/chatbot/Dockerfile
AGENT_ADDR=${AGENT_ENDPOINT}:${AGENT_PORT}
APPLICATION_ENDPOINT=${FRONTEND_HOST}:${FRONTEND_PORT}
TRACELOOP_BASE_URL=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_HTTP}
OPAMP_SERVER_HOST=opamp-server
OPAMP_SERVER_UI_PORT=4321
OPAMP_SERVER_DOCKERFILE=./src/opamp-server/Dockerfile
FIREPIT_PORT=8080
FIREPIT_HOST=firepit
TELEMETRY_DOCS_HOST=telemetry-docs
TELEMETRY_DOCS_PORT=8000
TELEMETRY_DOCS_DOCKERFILE=./src/telemetry-docs/Dockerfile
